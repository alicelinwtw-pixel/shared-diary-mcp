# Generate a unique random value of at least 32 characters.
DIARY_ADMIN_KEY=replace-with-a-long-random-secret

# Local default. Use a persistent mounted path in production.
DIARY_DB_PATH=data/shared-diary.sqlite3

DIARY_TIMEZONE=Asia/Shanghai

# Optional when automatic URL detection is correct.
# DIARY_PUBLIC_URL=https://your-host.example
